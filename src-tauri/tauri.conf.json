{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sintra Glass",
  "version": "1.0.0",
  "identifier": "pl.sintraglass.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Sintra Glass - Witraze Sintry",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
