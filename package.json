{
  "name": "sintra-glass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "train:ai": "node scripts/compileTraining.cjs && node scripts/advanced.cjs",
    "train:quick": "node scripts/compileTraining.cjs && node scripts/advanced.cjs --preset quick",
    "train:legacy": "node scripts/compileTraining.cjs && node scripts/train.cjs && node scripts/refine.cjs",
    "train:deep": "node scripts/compileTraining.cjs && node scripts/advanced.cjs --preset deep",
    "train:resume": "node scripts/compileTraining.cjs && node scripts/advanced.cjs --resume",
    "train:smoke": "node scripts/compileTraining.cjs && node scripts/advanced.cjs --preset quick --generations 1 --population 2 --games 2 --holdout 3 --h2h 4 --no-promote --seed 7654321"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
